RewriteEngine On

# Transmettre l'en-tête Authorization à PHP (Apache le filtre sinon)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Router simple
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^v1/quote$ v1/quote.php [L,QSA]

# Bloquer l'accès direct aux fichiers sensibles
<FilesMatch "\.(sql|sh|py|joblib|pkl|log)$">
    Require all denied
</FilesMatch>
